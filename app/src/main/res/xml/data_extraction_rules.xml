<?xml version="1.0" encoding="utf-8"?>
<!--
    Step 18: Android 12+ replacement for full-backup-content — governs both
    cloud backup AND device-to-device transfer. Same exclusion as
    backup_rules.xml, kept in sync.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="tva_profile.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="tva_profile.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
